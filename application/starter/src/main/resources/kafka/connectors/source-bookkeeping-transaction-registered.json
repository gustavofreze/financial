    "skipped.operations": "u,d,t",
    "message.key.columns": "bookkeeping.transactions:code",
    "include.schema.changes": false,
    "publication.name": "dbz_publication",
    "publication.autocreate.mode": "disabled",

    "snapshot.mode": "initial",

    "database.port": 5432,
    "database.user": "debezium",
    "database.dbname": "financial_adm",
    "database.password": "Qz7&dbzLc4Tm",
    "database.hostname": "postgresql",

    "table.include.list": "bookkeeping.transactions",

    "transforms": "unwrap, Reroute, SetKeySchemaMetadata, SetSchemaMetadata",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.Reroute.type": "io.debezium.transforms.ToLogicalTopicRouter",
    "transforms.Reroute.topic.regex": "(.*)transactions(.*)",
