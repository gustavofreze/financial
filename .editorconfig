root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

# The tests mark each step with a one-line doc comment (/** @Given ... */), the form of the reference projects, so
# the rule that admits KDoc only on a declaration does not apply to them. Production code keeps it.
[**/src/test/**.kt]
ktlint_standard_kdoc = disabled

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2
